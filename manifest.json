{
  "manifest_version": 3,
  "name": "Selective History",
  "version": "1.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/options/index.html",
  "permissions": ["history", "storage"]
}
